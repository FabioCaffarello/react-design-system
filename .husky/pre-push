# Run tests before push
echo "Running unit tests..."
npm run test

# Run full lint check
echo "Running lint check..."
npm run lint

# Typecheck with project references (tsc --build --force). The founding
# trauma of this harness is a typecheck gate that silently checked
# nothing (the `tsc -p` vs `--build` trap — see .claude/rules/ci-gates.md);
# the cost asymmetry is ~30s per push vs months of false-green. The husky
# v9 shim runs this file with `sh -e`, so a non-zero exit here aborts
# the push.
echo "Running typecheck..."
npm run typecheck

# Validate dark-theme coverage (both blocks in dark.css must stay in
# lockstep — see scripts/validate-dark-coverage.mjs header for context).
echo "Validating dark-theme coverage..."
node scripts/validate-dark-coverage.mjs

# Validate component file-set discipline (every component dir under
# src/ui/{primitives,components,layouts}/ ships .tsx, .test.tsx,
# .stories.tsx, index.ts). Grandfathered exceptions are allowlisted
# inside the script and shrink as Wave 2 fills the missing tests.
echo "Validating component file-set..."
node scripts/validate-file-set.mjs

# Validate the three-layer import rule: primitives never import from
# components or layouts; layouts import primitives only. Components
# may import any primitive and each other.
echo "Validating cross-layer imports..."
node scripts/validate-cross-layer-imports.mjs

# Validate that infra Provider/Context modules (Toast/Dialog/Theme/
# Config) live ONLY in src/ui/providers/. A duplicate elsewhere
# creates a second React Context instance at module evaluation time
# and silently breaks consumer hooks — see scripts/validate-provider-
# canonicity.mjs header for the historical case this gate closes.
echo "Validating provider canonicity..."
node scripts/validate-provider-canonicity.mjs

# Validate the server-entry contract (issue #150). src/ui/server.ts
# must re-export only modules that the transitive analyser classifies
# as server-safe, must import each from its concrete source file (no
# barrels), and if dist/server/ exists from a recent build, must
# carry zero client-API call sites in the emitted bundle. The dual
# `validate-use-client-in-dist.mjs` runs at build time (build:validate
# step in package.json) and is not duplicated here — pre-push runs
# before `npm run build` would in CI.
echo "Validating server entry..."
node scripts/validate-server-entry.mjs

# Validate docs sync (mechanical half of .claude/rules/docs-sync.md):
# every `npm run X` mentioned in a doc exists in package.json scripts,
# and every relative markdown link resolves. Negative references carry
# a `docs-ok:` marker on/above the line.
echo "Validating docs sync..."
node scripts/validate-docs-sync.mjs
