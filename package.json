{
  "name": "@fabio.caffarello/react-design-system",
  "private": false,
  "version": "1.14.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/ui/index.d.ts",
  "style": "dist/react-design-system.css",
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "style": "./dist/react-design-system.css",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/react-design-system.css",
    "./styles.css": "./dist/react-design-system.css",
    "./primitives": {
      "types": "./dist/ui/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.cjs"
    },
    "./components": {
      "types": "./dist/ui/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./tokens": {
      "types": "./dist/ui/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./providers": {
      "types": "./dist/ui/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc --project tsconfig.app.json --declaration --emitDeclarationOnly --outDir dist || true && vite build && npm run build:validate",
    "build:validate": "tsx scripts/validate-build-exports.ts",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:smoke": "npm run build-storybook && node scripts/storybook-smoke.mjs",
    "plop": "plop",
    "postplop": "prettier -w './src/ui/**/*.{ts,tsx}'",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.0.0",
    "lucide-react": "^0.552.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7.71.0",
    "zod": "^3.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.36.0",
    "@hookform/resolvers": "^3.0.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.0.3",
    "@storybook/addon-coverage": "^3.0.0",
    "@storybook/addon-designs": "^11.1.1",
    "@storybook/addon-docs": "^10.0.3",
    "@storybook/addon-measure": "^9.0.8",
    "@storybook/addon-outline": "^9.0.8",
    "@storybook/addon-vitest": "^10.0.3",
    "@storybook/react-vite": "^10.0.3",
    "@storybook/test": "^8.6.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.7",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser-playwright": "^4.0.6",
    "@vitest/coverage-v8": "^4.0.6",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.14",
    "dependency-cruiser": "^17.3.6",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-storybook": "^10.0.3",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.7",
    "lucide-react": "^0.552.0",
    "madge": "^8.0.0",
    "plop": "^4.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react-hook-form": "^7.71.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.0.3",
    "storybook-addon-performance": "^0.17.3",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.6",
    "zod": "^3.0.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "volta": {
    "node": "23.11.1"
  }
}
