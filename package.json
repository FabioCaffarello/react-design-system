{
  "name": "@fabio.caffarello/react-design-system",
  "private": false,
  "version": "1.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/ui/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npx tsc --project tsconfig.app.json --declaration --emitDeclarationOnly --outDir dist && vite build",
    "lint": "eslint .",
