import { forwardRef, memo } from 'react';
import type { HTMLAttributes } from 'react';
import { cn, cva, type VariantProps } from '../../utils';
{{#if usesTokens}}
import { {{tokenImports}} } from '../../tokens';
{{/if}}

{{#if hasVariants}}
const {{camelCase name}}Variants = cva(
  // Base classes
  cn(
    'inline-flex',
    'items-center',
    'justify-center',
    'transition-colors',
    'focus:outline-none',
    'disabled:opacity-50',
    'disabled:cursor-not-allowed'
  ),
  {
    variants: {
      variant: {
        {{#each variants}}
        {{this}}: '...', // TODO: Add variant styles
        {{/each}}
      },
      {{#if hasSizes}}
      size: {
        {{#each sizes}}
        {{this}}: '...', // TODO: Add size styles
        {{/each}}
      },
      {{/if}}
    },
    {{#if defaultVariant}}
    defaultVariants: {
      variant: '{{defaultVariant}}',
      {{#if hasSizes}}
      size: '{{defaultSize}}',
      {{/if}}
    },
    {{/if}}
  }
);
{{/if}}

export interface {{pascalCase name}}Props extends Omit<HTMLAttributes<HTMLDivElement>, 'as'>{{#if hasVariants}}, VariantProps<typeof {{camelCase name}}Variants>{{/if}} {
  {{#if children}}
  children?: React.ReactNode;
  {{/if}}
  {{#if hasCustomProps}}
  // Add custom props here
  {{/if}}
}

/**
 * {{pascalCase name}} Component
 * 
 * {{description}}
 * 
 * @example
 * ```tsx
 * <{{pascalCase name}} variant="{{defaultVariant}}" size="{{defaultSize}}">
 *   Content
 * </{{pascalCase name}}>
 * ```
 */
export const {{pascalCase name}} = memo(forwardRef<HTMLDivElement, {{pascalCase name}}Props>(
  ({ 
    className,
    {{#if hasVariants}}
    variant,
    {{#if hasSizes}}
    size,
    {{/if}}
    {{/if}}
    {{#if children}}
    children,
    {{/if}}
    ...props 
  }, ref) => {
    return (
      <div
        ref={ref}
        className={cn(
          {{#if hasVariants}}
          {{camelCase name}}Variants({ variant{{#if hasSizes}}, size{{/if}} }),
          {{/if}}
          className
        )}
        {{#if accessibility}}
        role="..."
        aria-label="..."
        {{/if}}
        {...props}
      >
        {{#if children}}
        {children}
        {{/if}}
      </div>
    );
  }
));

{{pascalCase name}}.displayName = '{{pascalCase name}}';

export default {{pascalCase name}};
