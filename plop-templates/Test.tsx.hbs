import { createRef } from "react";
import { describe, it, expect } from "vitest";
import { render, screen } from "@testing-library/react";
import {{pascalCase name}} from "./{{pascalCase name}}";

describe("{{pascalCase name}}", () => {
  describe("rendering", () => {
    it("renders its children", () => {
      render(<{{pascalCase name}}>Content</{{pascalCase name}}>);
      expect(screen.getByText("Content")).toBeInTheDocument();
    });

    it("merges a custom className onto the root element", () => {
      render(<{{pascalCase name}} className="custom-class">Content</{{pascalCase name}}>);
      expect(screen.getByText("Content")).toHaveClass("custom-class");
    });
  });

  describe("props pass-through", () => {
    it("spreads rest props onto the root element", () => {
      render(<{{pascalCase name}} id="root-id">Content</{{pascalCase name}}>);
      expect(screen.getByText("Content")).toHaveAttribute("id", "root-id");
    });

    it("forwards its ref to the root element", () => {
      const ref = createRef<HTMLDivElement>();
      render(<{{pascalCase name}} ref={ref}>Content</{{pascalCase name}}>);
      expect(ref.current).toBeInstanceOf(HTMLDivElement);
    });
  });
});
